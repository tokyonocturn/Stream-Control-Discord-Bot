# --- Discord ---
DISCORD_TOKEN=

# --- Twitch ---
TWITCH_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
# Twitch channel name to bridge chat from / IRC bot nickname to log in as
TWITCH_CHANNEL_NAME=
TWITCH_BOT_USERNAME=

# --- Discord server / role / channel IDs ---
# Right-click a server, role, or channel in Discord (Developer Mode on) to copy its ID
TARGET_GUILD_ID=
LOG_CHANNEL_ID=
TWITCH_SUB_ROLE_ID=
# Comma-separated list of role IDs allowed to use admin commands
ALLOWED_ROLE_IDS=

CHANNEL_DONO_INFO=
CHANNEL_ACTIVE_SUBS=
CHANNEL_TWITCH_CHAT=
CHANNEL_MOD_ACTIONS=
# Optional. Full audit log: every command anyone runs (master + Twitch bot),
# who ran it, what options, and whether it was allowed or denied.
# Leave blank to disable.
COMMAND_LOG_CHANNEL_ID=

# --- OBS WebSocket (Tools > WebSocket Server Settings in OBS) ---
OBS_IP=
OBS_PORT=4455
OBS_PASSWORD=

# --- Optional: audio device name for /obsjoin (Windows only) ---
# Leave blank to use the default: CABLE Output (VB-Audio Virtual Cable)
AUDIO_DEVICE=
